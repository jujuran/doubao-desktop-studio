{
  "name": "doubao-desktop-studio",
  "version": "0.1.3",
  "private": true,
  "author": "jujuran",
  "description": "Cross-platform, local-first workspace for isolated Doubao account sessions.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vue-tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "clean:release": "node scripts/clean-release.mjs",
    "predist:win": "npm run clean:release",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "postdist:win": "node scripts/finalize-release.mjs",
    "predist:mac": "npm run clean:release",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "postdist:mac": "node scripts/finalize-release.mjs"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.1.1",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.local.doubao.desktopstudio",
    "productName": "Doubao Desktop Studio",
    "asar": true,
    "directories": {
      "output": "release/current"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
